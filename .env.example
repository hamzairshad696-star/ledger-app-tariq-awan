# ------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own values.
# Never share .env.local or commit it anywhere.
# ------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, or a local PostgreSQL).
# Neon example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local example: postgres://postgres:YOUR_PASSWORD@localhost:5432/ledger
DATABASE_URL=

# Long random string used to sign login sessions (at least 32 characters).
# Generate one with:  npm run secret
AUTH_SECRET=

# Admin account created on first setup. The password is only used when the
# admin account does not exist yet; afterwards change it in Settings.
ADMIN_USERNAME=tariq
ADMIN_PASSWORD=
ADMIN_NAME="Tariq Awan"

# Year the app opens on, and the timezone used to decide the "current month".
DEFAULT_YEAR=2026
APP_TIMEZONE=Asia/Karachi

# Load demo data automatically during setup/Vercel build if the database is empty (true/false).
SEED_DEMO=false

# Testing only: pretend today is this date (YYYY-MM-DD). Leave empty in real use.
APP_TODAY=
